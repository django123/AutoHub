<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.ocarius</groupId>
    <artifactId>autohub-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>AutoHub :: Parent</name>

    <!--
      ARCHITECTURE HEXAGONALE : LES MODULES SONT LA FRONTIERE PHYSIQUE
      ================================================================
      L'ordre de declaration reflete le sens des dependances :

          domain  <-  application  <-  infrastructure  <-  bootstrap

      Une dependance ne peut aller QUE de droite a gauche.
      Maven refusera de compiler si on tente l'inverse : c'est une
      contrainte du build, pas une regle de discipline personnelle.

      C'est la difference entre "je fais attention" et "c'est impossible".
    -->
    <modules>
        <module>autohub-domain</module>
        <module>autohub-application</module>
        <module>autohub-infrastructure</module>
        <module>autohub-bootstrap</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Verifier la version courante avant de demarrer : https://spring.io/projects/spring-boot -->
        <spring-boot.version>3.5.4</spring-boot.version>
        <archunit.version>1.3.0</archunit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
              On importe le BOM Spring Boot SANS utiliser spring-boot-starter-parent
              comme parent POM. Raison pedagogique : le module domain ne doit heriter
              d'AUCUNE configuration Spring. Le BOM ne fait qu'aligner les versions
              pour les modules qui choisissent d'utiliser Spring.
            -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
                <scope>test</scope>
            </dependency>

            <!-- Modules internes -->
            <dependency>
                <groupId>com.ocarius</groupId>
                <artifactId>autohub-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ocarius</groupId>
                <artifactId>autohub-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ocarius</groupId>
                <artifactId>autohub-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Tests : disponibles partout, y compris dans le domaine -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>
</project>
