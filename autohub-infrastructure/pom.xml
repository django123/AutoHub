<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ocarius</groupId>
        <artifactId>autohub-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>autohub-infrastructure</artifactId>
    <name>AutoHub :: Infrastructure</name>

    <!--
      Ici, et SEULEMENT ici, on a le droit d'utiliser des frameworks.
      C'est la couche des ADAPTATEURS :
        - adapters entrants  (REST, CLI, consumers Kafka plus tard)
        - adapters sortants  (JPA, clients HTTP, publication d'evenements)

      Toute la "salete technique" est confinee dans ce module.
      C'est exactement le but de l'architecture hexagonale.
    -->
    <dependencies>
        <dependency>
            <groupId>com.ocarius</groupId>
            <artifactId>autohub-application</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <!-- Depuis Flyway 10, le support PostgreSQL est dans un artefact separe -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
    </dependencies>
</project>
